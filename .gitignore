# Hong Kong Port Digital Twin — .gitignore
# Keep this file as ignore patterns only. Do not list individual tracked paths.

# Python environments and caches
venv/
.venv/
**/venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local env / secrets
.env
.env.*
!.env.example

# Local ops / keep-alive helpers (not part of Streamlit Cloud deploy)
install_cron.sh
keep_app_alive.sh
setup_cron.md

# OS / editor
.DS_Store
**/.DS_Store
.idea/
.vscode/

# Timestamped source-code backups (use git history instead)
hk_port_digital_twin/src/dashboard/*backup*.py
hk_port_digital_twin/src/dashboard/*before*.py
backups/

# Generated / local run artifacts
*.log
.benchmarks/
benchmarks/
hk_port_digital_twin/benchmarks/
hk_port_digital_twin/benchmark_report_*.json

# === SENSITIVE FILES AND DIRECTORIES ===
# Exclude entire planning directory (contains internal strategy and development notes)
planning/
!planning/README.md

# Exclude presentation materials (may contain sensitive business information)
planning/presentation_Nov_2025/

# Exclude internal development notes and strategies
planning/*_plan*.md
planning/notes.md
planning/learnings_from_debugging.md

# Exclude task management files (internal workflow)
tasks/

# Exclude raw data backups (large files, potentially sensitive vessel data)
raw_data/vessel_data/backups/
raw_data/vessel_data/logs/

# Exclude environment and configuration files
.env
.env.local
.env.production

# Exclude large benchmark files
benchmarks/
.benchmarks/

# Exclude backup directories
backups/

# Exclude system files
.DS_Store
**/.DS_Store
